{
  "id": "comicwang",
  "name": "漫画网 comicwang",
  "lang": "cn",
  "note": "详情 /title/<id>.html，章节 /scan/<id>-<sid>-<nid>.html；章节页图片在 player_aaaa 对象的 \"url\" 字段里用 ||| 分隔。",
  "domains": [
    "comicwang.com",
    "www.comicwang.com"
  ],
  "search_url": "https://www.comicwang.com/search.html?wd={q}",
  "headers": {
    "Referer": "https://www.comicwang.com/",
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "comic": {
    "title": {
      "css": "h1.mg-detail-title",
      "text": true
    },
    "author": {
      "css": ".mg-detail-meta li",
      "text": true,
      "re": "作者[：:](.+)",
      "all": true
    },
    "cover": {
      "css": "meta[property='og:image']",
      "attr": "content"
    },
    "status": {
      "css": ".mg-detail-status",
      "text": true
    },
    "description": {
      "css": ".mg-info-section",
      "text": true,
      "all": true
    },
    "tags": {
      "css": ".mg-detail-meta a",
      "text": true,
      "all": true
    }
  },
  "chapters": {
    "list": {
      "css": "ul.mg-chapter-list li a"
    },
    "url_re": "/scan/\\d+-\\d+-\\d+\\.html$"
  },
  "pages": {
    "list": {
      "css": ".hl-player-wrap img"
    },
    "url": {
      "attr": "src"
    },
    "lazy_js": "\"url\"\\s*:\\s*\"([^\"]+?\\.jpg(?:\\|[^\"]*)?)\"",
    "split": "|||",
    "filter": "\\.(?:jpg|jpeg|png|webp)(?:$|\\?)"
  },
  "search": {
    "url": "https://www.comicwang.com/search.html?wd={q}",
    "list": {
      "css": "div.mg-search-item"
    },
    "link": {
      "css": "a.mg-search-thumb",
      "attr": "href"
    },
    "title": {
      "css": ".mg-search-name a",
      "text": "direct"
    },
    "cover": {
      "css": "a.mg-search-thumb",
      "attr": "data-original"
    }
  }
}
