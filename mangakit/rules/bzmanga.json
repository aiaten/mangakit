{
  "id": "bzmanga",
  "name": "包子漫画 bzmanga.com",
  "lang": "cn",
  "note": "详情 /comic/<拼音>，章节是查询串形态 /user/page_direct?comic_id=..&section_slot=..&chapter_slot=..，章节选择器必须限定 a.comics-chapters__item（页面上还有 /user/operation_v2?op=set_bookmark 之类同前缀的干扰链接）。标题在 h1.comics-detail__title（页面上另一个 h1 是站点名「包子漫画」）。封面走 og:image，正文图床是 s1/s2.bzcdn.net/scomic/…。章节页必须带 Referer（否则只返回 4KB 空壳），规则里已配 headers。",
  "domains": [
    "bzmanga.com",
    "cn.bzmanga.com",
    "www.bzmanga.com"
  ],
  "search_url": "https://cn.bzmanga.com/search?q={q}",
  "headers": {
    "Referer": "https://cn.bzmanga.com/",
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "comic": {
    "title": {
      "css": "h1.comics-detail__title",
      "text": "direct"
    },
    "cover": {
      "css": "meta[property='og:image']",
      "attr": "content"
    },
    "author": {
      "css": "h2.comics-detail__author",
      "text": true
    },
    "description": {
      "css": ".comics-detail__desc, .supporting-text",
      "text": true
    },
    "tags": {
      "css": ".tag-list span.tag",
      "text": true,
      "all": true
    },
    "status": {
      "css": ".tag-list span.tag",
      "text": true
    }
  },
  "chapters": {
    "list": {
      "css": "a.comics-chapters__item[href*='page_direct']"
    },
    "url_re": "page_direct\\?.*chapter_slot=\\d+$"
  },
  "pages": {
    "list": {
      "css": "img[src*='bzcdn.net']"
    },
    "url": {
      "attr": "src"
    },
    "filter": "^https?://[^/]*bzcdn\\.net/scomic/.*\\.(?:jpg|jpeg|png|webp)(?:\\?|$)"
  },
  "search": {
    "url": "https://cn.bzmanga.com/search?q={q}",
    "list": {
      "css": "div.comics-card"
    },
    "link": {
      "css": "a.comics-card__poster[href^='/comic/']",
      "attr": "href"
    },
    "title": {
      "css": "a.comics-card__poster",
      "attr": "aria-label",
      "url": false
    },
    "cover": {
      "css": "a.comics-card__poster amp-img[src*='/cover/']",
      "attr": "src"
    }
  }
}