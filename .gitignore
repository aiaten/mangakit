# =====================================================================
#  漫卷 MangaKit — Git 忽略规则
#
#  编写依据：本机 mangakit\ 目录的实际目录树（2026-10-13 核对）。
#  原则：只忽略「能由源码重新生成的东西」和「本机运行时数据」，
#        站点规则（mangakit\rules\*.json）、文档、assets\ 一律保留。
#
#  注意：mangakit\rules\*.json 是程序的一部分（不是生成物），
#        绝对不要被任何 *.json 通配规则吃掉。
# =====================================================================

# ---------------------------------------------------------------------
# 1. 打包产物
# ---------------------------------------------------------------------
# PyInstaller 中间目录（本机实测 70.4 MB：Analysis/EXE/PKG-00.toc、
# base_library.zip、PYZ-00.pyz、MangaKit.pkg …）
/build/

# 打包输出目录。正式产物 dist\MangaKit.exe 本机实测 63.4 MB
# （66,435,670 字节，2026-10-12 20:10:45 构建）；QtWebEngine 版探针
# 更大（.tmp\pack\dist\packlazy.exe 148.3 MB、packprobe.exe 210.4 MB），
# 都属实验产物，不进仓库。
#
# 体积规则：GitHub 对「单个 Git 对象」有 100 MB 硬上限，
#           而 Release 资产（gh release create 上传的附件）单文件上限 2 GB。
#           所以 exe 只走 Release 附件，不提交进 Git —— 这正是本文件的作用。
#
# 如果你希望在 dist\ 下留一份「这里该有什么」的说明文件，
# 取消下面第二行的注释，并确保 dist\README.md 真实存在：
/dist/*
!/dist/README.md

# 兜底：任何位置的 exe 都不提交（本机 .tmp\ 与 tools\_smoke\ 下有 30 多个探针 exe）
*.exe

# Windows 快捷方式（.lnk）是「指向某台机器上某个路径」的本机文件，
# 换台机器就失效，永远不该进仓库。仓库根下出现过 MangaKit.exe.lnk
# （指向 dist\MangaKit.exe 的手工快捷方式），用这条兜住。
*.lnk

# ---------------------------------------------------------------------
# 2. 运行时数据（本机跑出来的，不是源码）
# ---------------------------------------------------------------------
# 便携模式数据目录：config.json / mangakit.db / logs\
# （dist\MangaKitData\ 已随 /dist/* 被忽略，这里再兜一层）
**/MangaKitData/

# 仓库根下的本地配置（程序真正的配置在 %APPDATA%\mangakit\，
# 便携模式才会落到程序旁边）
/config.json

# 运行日志：mangakit.log、mangakit_selftest.log（main.py 的 MANGAKIT_TRACE 诊断日志）
*.log

# ---------------------------------------------------------------------
# 3. 临时目录与一次性实验产物
# ---------------------------------------------------------------------
# 启动器 启动漫卷.bat 的工作目录（单文件 exe 解包用）。
# 本机实测根目录 .tmp\ 有 2,517.8 MB：pack\（打包探针）、we\（QtWebEngine
# 探针）、survey\（异次元图源调研）、yck\、icon\、mkrun\、rt{,2,3,4}\ …
/.tmp/
**/.tmp/

# PyInstaller onefile 解包残留（正常退出会自己删，被强杀会留下几百 MB dll）
_MEI*/
**/_MEI*/

# 冒烟 / 实网验证的下载样本（本机实测 tools\_smoke\ = 169.5 MB，
# 含 6 个站的样本图与一个 146.6 MB 的 _MEI 解包目录）
/tools/_smoke/

# 离线测试脚本在仓库根留下的临时目录与导出产物。
# 这些脚本都用 tempfile.mkdtemp(prefix="mk_...") 建临时目录，而本机 tmp 不可写时
# tempfile 会退回当前工作目录，于是根目录会攒下一堆 mk_exp_xxx.cbz / mk_gui_fav_xxx\
# / mk_home_xxx\ / mktest_xxx\。跑完就删是正解，但漏删一次就会污染 git add -A，
# 所以在这里兜底（注意只兜这些前缀，别写成笼统的 mk_* 以免误伤真实文件）。
/mk_exp_*
/mk_adp_*
/mk_fix_*
/mk_gui_fav_*
/mk_home_*
/mk_t3_*
/mk_dev_*
/mk_epub_*
/mk_fname_*
/mktest_*
/chk_*
# 下面这些前缀是 2026-10-18 补的：当天排查 Qt 退出崩溃时才发现，实际在根目录
# 攒下来的前缀比上面列的多得多（一次排查就攒了 300 多个目录，git status 里
# 全是噪音，真正的改动反而看不见）。原则不变：只兜测试脚本自己建的临时前缀，
# 不写笼统的 mk_*。
/mk_favbtn_*
/mk_probe_*
/mk_p_*
/mk_bench_*
/mk_conc_*
/mk_nav_*
/mk_smoke_*
/mk_upd_*
/mk_gui_addsite_*
/mk_iso_*
/mk_yck_*
/mk_export_*
/mk_sfav_*
/mk_click_*
/mk_c4k_*

# tools\t_publish.py 的两个中间产物。它们本该落在 tempfile.gettempdir()，但本机
# 系统 TEMP 不可写、gettempdir() 退回仓库根，于是 dry-run 一次就在根目录留下
# MangaKit-launcher.bat（启动器的临时副本）和 mangakit_release_*.md（Release 说明）。
# 这两个都是脚本自动生成的，绝不该提交。
/MangaKit-launcher.bat
/mangakit_release_*.md

# tools\verify.py 的实网验证结果：每次跑都会重写（站点章节数天天变），
# 想把它当发布存证就删掉这一行。
/tools/verify.out.json

# 一次性排查脚本（tools\_xxx.py 约定：下划线前缀 = 用完即弃的探针）。
# 正式测试脚本不带下划线（t_updates.py / gui_smoke.py / check_*.py），不要忽略。
# md 也在内：发布说明这类临时文本同样不该进仓库。
/tools/_*.py
/tools/_*.txt
/tools/_*.json
/tools/_*.md

# 2026-10-14 收藏清空事故的取证与备份目录。
# **里面是本机用户的真实 mangakit.db 副本，绝不能提交**：
#   mangakit.db.frozen                  事故现场冻结副本（含真实收藏残字节）
#   mangakit.db.pre-restore-*           写回前的备份
#   mangakit.db.pre-clean-*             清理测试数据前的备份
/tools/_incident/

# ---------------------------------------------------------------------
# 4. Python 缓存
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------
# 5. 备份 / 编辑器 / 环境杂项
# ---------------------------------------------------------------------
*.spec.bak
*.bak
*.orig
*.rej
*.swp
*~
.env
.venv/
venv/

# =====================================================================
#  必须【不要】忽略的东西（此处仅作提醒，不要添加对应规则）：
#    mangakit\mangakit\rules\*.json   22 条站点规则，程序本体
#    assets\mangakit.ico              程序图标
#    assets\splash.png                启动图素材
#    使用文档.md / 使用文档.txt        使用文档（txt 由 tools\md2txt.py 生成）
#    漫画下载器 使用文档.txt            同上，纯文本版
#    mangakit.spec                    PyInstaller 打包配置
#    启动漫卷.bat                      启动器（务必随 exe 一起分发）
#    selfcheck.py / tools\*.py         测试与开发脚本
# =====================================================================
